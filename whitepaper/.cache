server {
    server_name apply.decentralmiami.net; # managed by Certbot
    location / {
	    proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
    }
    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/apply.decentralmiami.net/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/apply.decentralmiami.net/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}


server {
    listen 80 ;
    listen [::]:80 ;
    server_name apply.decentralmiami.net;
    return  301 https://apply.decentralmiami.net$request_uri;
}
